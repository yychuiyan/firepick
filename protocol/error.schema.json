{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firepick.local/schema/error.json",
  "title": "Bridge error",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "unauthorized",
        "pairing_code_invalid",
        "config_missing",
        "session_missing",
        "provider_timeout",
        "provider_failed",
        "runtime_missing",
        "proxy_expired",
        "unsupported",
        "bad_request"
      ]
    },
    "message": { "type": "string" }
  },
  "additionalProperties": false
}

